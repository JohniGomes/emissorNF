# Banco de dados (Supabase — Project Settings > Database > Connection string > Connection Pooling)
# Transaction mode (porta 6543) — usada pela aplicação em runtime (serverless-friendly).
DATABASE_URL="postgresql://postgres.[REF]:[SUA-SENHA]@[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session mode (porta 5432, mesmo host do pooler) — usada pelo Prisma para rodar migrations.
DIRECT_URL="postgresql://postgres.[REF]:[SUA-SENHA]@[REGIAO].pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-um-valor-com: openssl rand -base64 32"

# Focus NFe (https://focusnfe.com.br)
# Token principal da CONTA (painel Focus NFe > Tokens), usado pelo servidor
# para cadastrar empresas de clientes automaticamente via API.
FOCUS_NFE_MASTER_TOKEN="seu-token-principal-aqui"

# Chave usada para criptografar dados sensíveis (tokens, certificados) em repouso.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY="gere-uma-chave-aqui"

# Segredo para autenticar chamadas do Vercel Cron às rotas de notas recorrentes.
# Gere com: openssl rand -base64 32
CRON_SECRET="gere-um-valor-aqui"

# Segredo do webhook da Focus NFe (painel Focus NFe > Empresa > Webhook,
# cadastre a URL como https://SEU_DOMINIO/api/webhooks/focus-nfe?token=ESTE_VALOR).
# Gere com: openssl rand -base64 32
FOCUS_NFE_WEBHOOK_SECRET="gere-um-valor-aqui"
