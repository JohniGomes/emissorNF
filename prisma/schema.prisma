generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresas Empresa[]
}

/**
 * Registra tentativas de login que falharam, só pra permitir rate limiting
 * (bloquear depois de N tentativas por e-mail numa janela de tempo). Nunca
 * grava a senha, só o e-mail tentado e quando foi.
 */
model TentativaLoginFalha {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Empresa {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  razaoSocial       String
  nomeFantasia      String?
  cnpj              String   @unique
  telefone          String?
  celular           String?
  inscricaoMunicipal String?
  regimeTributario  String
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  municipioCodigoIbge String
  cep               String?
  uf                String

  // Referência ao token/config da empresa no provedor fiscal (Focus NFe).
  // O token real fica armazenado criptografado, nunca em texto puro.
  focusNfeTokenEncrypted String?
  focusNfeAmbiente       String  @default("sandbox") // sandbox | producao
  focusNfeEmpresaId      Int? // id numérico da empresa na Focus NFe (necessário p/ endpoints de gestão, ex: certificado)

  // Só indica que um certificado já foi enviado — nunca guardamos o arquivo
  // nem a senha aqui, isso fica só na Focus NFe.
  certificadoDigitalConfigurado Boolean @default(false)

  // Classificação fiscal exigida pela NFS-e Nacional (DPS), usada só por
  // empresas MEI. Não temos como inferir esses códigos com segurança —
  // o próprio usuário/contador preenche, e a Focus valida antes de autorizar.
  codigoOpcaoSimplesNacional String?
  regimeEspecialTributacao   String?
  proximoNumeroDps           Int     @default(1)

  // Assinatura (cada assinatura = 1 CNPJ). Pagamento mock por enquanto.
  planoId         String?
  cicloCobranca   String? // "mensal" | "anual"
  assinaturaAtiva Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientes         Cliente[]
  notas            Nota[]
  notasRecorrentes NotaRecorrente[]
  servicos         Servico[]
  logs             LogAuditoria[]

  @@index([userId])
}

model Cliente {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  nome         String
  nomeFantasia String?
  documento    String // CNPJ ou CPF — o tipo de pessoa é inferido do tamanho (11=PF, 14=PJ)
  email        String?
  telefone     String?
  whatsapp     String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  municipio    String?
  municipioCodigoIbge String?
  uf           String?
  cep          String?

  // Só relevantes em municípios/regimes específicos — ficam numa seção
  // "avançada" na tela, nunca obrigatórios por padrão.
  inscricaoMunicipal String?
  inscricaoEstadual  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas            Nota[]
  notasRecorrentes NotaRecorrente[]

  @@index([empresaId])
}

model Nota {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  servicoId String?
  servico   Servico? @relation(fields: [servicoId], references: [id])

  descricaoServico String
  valor            Decimal @db.Decimal(12, 2)
  desconto         Decimal? @db.Decimal(12, 2)

  // Data da prestação do serviço, separada da data de emissão (que o backend
  // já trata conforme a lógica fiscal existente). Default = hoje, editável.
  dataCompetencia DateTime?
  observacoes     String?

  // Só preenchido para emissão via NFS-e Nacional (empresas MEI) — código de
  // tributação nacional do ISS referente ao serviço prestado.
  codigoTributacaoNacionalIss String?

  // Só relevantes para emissão via NFS-e clássica (empresas não-MEI) — item
  // da lista de serviços (LC 116/2003) e código NBS, quando o município exige.
  // Nunca inferidos automaticamente: o usuário informa, ou fica em branco.
  itemListaServico String?
  codigoNbs        String?

  status        StatusNota @default(PENDENTE)
  numero        String?
  codigoVerificacao String?
  linkPdf       String?
  respostaApi   Json?
  erro          String?

  // Chave gerada no cliente (1 por carregamento do formulário) para evitar
  // criar duas notas quando o usuário clica duas vezes ou a requisição é
  // reenviada por instabilidade de rede.
  idempotencyKey String? @unique

  notaRecorrenteId String?
  notaRecorrente   NotaRecorrente? @relation(fields: [notaRecorrenteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([clienteId])
  @@index([notaRecorrenteId])
  @@index([status])
}

enum StatusNota {
  PENDENTE
  PROCESSANDO
  AUTORIZADA
  ERRO
  CANCELADA
}

model NotaRecorrente {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  servicoId String?
  servico   Servico? @relation(fields: [servicoId], references: [id])

  descricaoServico String
  valor            Decimal @db.Decimal(12, 2)
  diaDoMes         Int // dia do mês em que a nota deve ser emitida
  ativo            Boolean @default(true)

  // Preparado para expansão futura (trimestral/semestral/anual) — hoje só
  // MENSAL é de fato executado pelo cron.
  periodicidade    String    @default("MENSAL")
  primeiraEmissao  DateTime?

  // null = sem prazo definido, roda até ser desativada manualmente. Quando
  // definido, decrementa a cada emissão bem-sucedida e desativa sozinha ao
  // chegar em zero — é o "emitir pelos próximos X meses" do usuário.
  mesesRestantes Int?

  // Só usado por empresas MEI (NFS-e Nacional exige esse código por emissão).
  codigoTributacaoNacionalIss String?

  ultimaExecucao DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas Nota[]

  @@index([empresaId])
  @@index([clienteId])
}

model Servico {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  nome      String  @default("")
  descricao String
  valor     Decimal @db.Decimal(12, 2)
  ativo     Boolean @default(true)

  // Código de tributação nacional (cTribNac, mesma tabela oficial usada na
  // emissão) e código NBS correlacionado — cadastrados uma vez aqui pra não
  // precisar escolher de novo em cada nota que usar este serviço.
  codigoTributacaoNacional String?
  codigoNbs                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas            Nota[]
  notasRecorrentes NotaRecorrente[]

  @@index([empresaId])
}

/**
 * Trilha de auditoria enxuta: eventos relevantes de segurança/negócio
 * (login, emissão, alteração/exclusão de cliente, cancelamento etc), sem
 * secrets nem dados sensíveis nos detalhes — só o necessário para investigar
 * "quem fez o quê e quando".
 */
model LogAuditoria {
  id         String   @id @default(cuid())
  empresaId  String?
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
  userId     String?
  acao       String
  entidadeId String?
  detalhes   Json?
  createdAt  DateTime @default(now())

  @@index([empresaId])
  @@index([acao])
  @@index([createdAt])
}
