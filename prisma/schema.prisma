generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresas Empresa[]
}

model Empresa {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])

  razaoSocial       String
  nomeFantasia      String?
  cnpj              String   @unique
  telefone          String?
  celular           String?
  inscricaoMunicipal String?
  regimeTributario  String
  logradouro        String?
  numero            String?
  complemento       String?
  bairro            String?
  municipio         String?
  municipioCodigoIbge String
  cep               String?
  uf                String

  // Referência ao token/config da empresa no provedor fiscal (Focus NFe).
  // O token real fica armazenado criptografado, nunca em texto puro.
  focusNfeTokenEncrypted String?
  focusNfeAmbiente       String  @default("sandbox") // sandbox | producao

  // Assinatura (cada assinatura = 1 CNPJ). Pagamento mock por enquanto.
  planoId         String?
  cicloCobranca   String? // "mensal" | "anual"
  assinaturaAtiva Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientes         Cliente[]
  notas            Nota[]
  notasRecorrentes NotaRecorrente[]
  servicos         Servico[]

  @@index([userId])
}

model Cliente {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  nome       String
  documento  String // CNPJ ou CPF
  email      String?
  logradouro String?
  numero     String?
  bairro     String?
  municipio  String?
  uf         String?
  cep        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas            Nota[]
  notasRecorrentes NotaRecorrente[]

  @@index([empresaId])
}

model Nota {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  descricaoServico String
  valor            Decimal @db.Decimal(12, 2)

  status        StatusNota @default(PENDENTE)
  numero        String?
  codigoVerificacao String?
  linkPdf       String?
  respostaApi   Json?
  erro          String?

  // Chave gerada no cliente (1 por carregamento do formulário) para evitar
  // criar duas notas quando o usuário clica duas vezes ou a requisição é
  // reenviada por instabilidade de rede.
  idempotencyKey String? @unique

  notaRecorrenteId String?
  notaRecorrente   NotaRecorrente? @relation(fields: [notaRecorrenteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([clienteId])
  @@index([notaRecorrenteId])
  @@index([status])
}

enum StatusNota {
  PENDENTE
  PROCESSANDO
  AUTORIZADA
  ERRO
  CANCELADA
}

model NotaRecorrente {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  descricaoServico String
  valor            Decimal @db.Decimal(12, 2)
  diaDoMes         Int // dia do mês em que a nota deve ser emitida
  ativo            Boolean @default(true)

  ultimaExecucao DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notas Nota[]

  @@index([empresaId])
  @@index([clienteId])
}

model Servico {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])

  descricao String
  valor     Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([empresaId])
}
